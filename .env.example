# ==============================================================================
# The Loan Eligibility Engine - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loan_engine
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loan_engine

# Self-Hosted n8n Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_WORKFLOW_B_WEBHOOK_URL=http://localhost:5678/webhook/match-users
N8N_WORKFLOW_C_WEBHOOK_URL=http://localhost:5678/webhook/send-notifications

# AI & LLM Service (Google Gemini API - Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# AWS Cloud Configuration (Optional if running locally via LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
S3_BUCKET_NAME=loan-eligibility-engine-uploads

# Notification Configuration (AWS SES Test Aliases)
# Replace with your own email username (e.g., yourname+test1@gmail.com)
SES_SOURCE_EMAIL=internetsurfing45@gmail.com
TEST_EMAIL_RECIPIENT=internetsurfing45+one@gmail.com
